<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} - %m%n"/>
        </Console>

        <!-- File Appender (Optional) -->
        <File name="FileLogger" fileName="logs/app.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} - %m%n"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- Log SQL Queries from JdbcTemplate -->
        <Logger name="org.springframework.jdbc.core" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
<!--            <AppenderRef ref="FileLogger"/>-->
        </Logger>

        <Logger name="org.springframework.jdbc.core.JdbcTemplate" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <!--            <AppenderRef ref="FileLogger"/>-->
        </Logger>

        <Logger name="ie.gti.asdl.rey" level="TRACE" additivity="false">
            <AppenderRef ref="Console"/>
<!--            <AppenderRef ref="FileLogger"/>-->
        </Logger>

        <!-- Root Logger -->
        <Root level="DEBUG">
            <AppenderRef ref="Console"/>
<!--            <AppenderRef ref="FileLogger"/>-->
        </Root>
    </Loggers>
</Configuration>